{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign category_filter = settings.category | default: "all" | downcase %}
{% assign items = data.items | default: items %}
{% assign pool = items %}
{% if category_filter != "all" %}
  {% assign pool = items | where: "category_key", category_filter %}
{% endif %}
{% assign filter_fallback = false %}
{% if pool == empty %}
  {% assign pool = items %}
  {% assign filter_fallback = true %}
{% endif %}

{% assign selected = selected_entry %}
{% unless selected %}
  {% if pool != empty %}
    {% assign selected = pool | sample %}
  {% endif %}
{% endunless %}

{% if selected %}
  {% assign name_length = selected.name | size %}
  {% assign epitaph_length = selected.epitaph | size %}

  {% assign compact_name_size = "title--large lg:title--xxlarge" %}
  {% assign full_name_size = "title--xlarge lg:title--xxlarge" %}
  {% if name_length > 20 %}
    {% assign compact_name_size = "title--base lg:title--xlarge" %}
    {% assign full_name_size = "title--large lg:title--xlarge" %}
  {% endif %}
  {% assign compact_epitaph_size = "description--large lg:description--xlarge" %}
  {% if epitaph_length > 80 %}
    {% assign compact_epitaph_size = "description--base lg:description--large" %}
  {% endif %}
  {% assign quadrant_name_size = "title--large lg:title--xxlarge" %}
  {% if name_length > 20 %}
    {% assign quadrant_name_size = "title--base lg:title--xlarge" %}
  {% endif %}
{% endif %}

{% capture goodbye_mark %}
  <svg class="w--[20px] h--[20px] shrink-0" viewBox="0 0 64 64" aria-hidden="true">
    <g fill="currentColor">
      <rect x="6" y="10" width="36" height="8"/>
      <rect x="6" y="10" width="8" height="48"/>
      <rect x="6" y="50" width="48" height="8"/>
      <rect x="46" y="34" width="8" height="24"/>
      <rect x="43" y="22" width="7" height="7"/>
      <rect x="49" y="11" width="8" height="8"/>
      <rect x="56" y="2" width="6" height="6"/>
    </g>
  </svg>
{% endcapture %}
