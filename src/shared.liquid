{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign category_filter = settings.category | default: "all" | downcase %}
{% assign items = data.items | default: items %}
{% assign pool = items %}
{% if category_filter != "all" %}
  {% assign pool = items | where: "category_key", category_filter %}
{% endif %}
{% assign filter_fallback = false %}
{% if pool == empty %}
  {% assign pool = items %}
  {% assign filter_fallback = true %}
{% endif %}

{% assign selected = nil %}
{% if pool != empty %}
  {% assign selected = pool | sample %}
{% endif %}

{% if selected %}
  {% assign name_length = selected.name | size %}
  {% assign epitaph_length = selected.epitaph | size %}

  {% assign compact_name_size = "title--large lg:title--xxlarge" %}
  {% assign full_name_size = "title--xlarge lg:title--xxlarge" %}
  {% if name_length > 20 %}
    {% assign compact_name_size = "title--base lg:title--xlarge" %}
    {% assign full_name_size = "title--large lg:title--xlarge" %}
  {% endif %}
  {% assign compact_epitaph_size = "description--large lg:description--xlarge" %}
  {% if epitaph_length > 80 %}
    {% assign compact_epitaph_size = "description--base lg:description--large" %}
  {% endif %}
{% endif %}

{% capture goodbye_mark %}
  <svg class="goodbye-mark" viewBox="0 0 64 64" aria-hidden="true">
    <g fill="currentColor">
      <rect x="6" y="10" width="36" height="8"/>
      <rect x="6" y="10" width="8" height="48"/>
      <rect x="6" y="50" width="48" height="8"/>
      <rect x="46" y="34" width="8" height="24"/>
      <rect x="43" y="22" width="7" height="7"/>
      <rect x="49" y="11" width="8" height="8"/>
      <rect x="56" y="2" width="6" height="6"/>
    </g>
  </svg>
{% endcapture %}

<style>
  .goodbye-wordmark {
    letter-spacing: 0.12em;
  }

  .goodbye-year {
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.06em;
    line-height: 0.86;
  }

  .goodbye-mark {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
  }

  .goodbye-titlebar {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .goodbye-image-frame {
    overflow: hidden;
    background: #fff;
  }

  .goodbye-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    filter: grayscale(1) contrast(1.08);
  }

  .goodbye-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .goodbye-full-layout {
    gap: 10px;
  }

  .goodbye-exhibit-bar {
    border-bottom: 2px solid #000;
    flex: 0 0 auto;
  }

  .goodbye-full-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 0;
    flex: 1 1 auto;
  }

  .goodbye-full-hero {
    aspect-ratio: 1.45 / 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #fff;
  }

  .goodbye-full-copy {
    min-width: 0;
    min-height: 0;
  }

  .goodbye-full-identity,
  .goodbye-full-details {
    min-width: 0;
  }

  .goodbye-afterlife {
    border-top: 1px solid #000;
  }

  @media (min-width: 1000px) {
    .goodbye-full-layout {
      gap: 18px;
    }

    .goodbye-exhibit-bar {
      border-bottom-width: 3px;
    }

    .goodbye-full-stage {
      display: flex;
      flex-direction: column;
      gap: 14px;
      align-items: stretch;
    }

    .goodbye-full-hero {
      aspect-ratio: 2.25 / 1;
      flex: 0 0 auto;
    }

    .goodbye-image--hero {
      object-position: center 52%;
    }

    .goodbye-full-copy {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
      gap: 32px;
      flex: 0 0 auto;
    }

    .goodbye-full-identity,
    .goodbye-full-details {
      gap: 10px;
    }

  }

  .goodbye-image--compact {
    aspect-ratio: 4 / 3;
    width: 100%;
    min-height: 0;
    flex: 0 0 auto;
  }

  .goodbye-image--vertical {
    aspect-ratio: 4 / 3;
    width: 100%;
    height: auto;
    min-height: 0;
    flex: 0 0 auto;
  }

  .goodbye-image--quadrant {
    aspect-ratio: 3 / 2;
    width: 34%;
    height: auto;
    min-height: 0;
    align-self: center;
    flex: 0 0 auto;
  }

  .goodbye-image--horizontal {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .goodbye-quadrant-title {
    font-size: 22px;
    line-height: 1;
  }

  @media (min-width: 1000px) {
    .goodbye-image--vertical {
      aspect-ratio: 5 / 3;
    }

    .goodbye-quadrant-title {
      font-size: 36px;
    }
  }
</style>
