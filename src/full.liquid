{% if selected %}
<div class="layout layout--col layout--stretch goodbye-full-layout">
  <div class="goodbye-exhibit-bar flex flex--row flex--between flex--center-y gap--small w--full pb--small lg:pb--medium">
    <div class="flex flex--row flex--center-y gap--small">
      <span class="label goodbye-wordmark">MUSEUM OF LOST THINGS</span>
      <span class="label label--outline">{{ selected.status | upcase }}</span>
    </div>
    <span class="label text--gray-30 text--right">{{ selected.lifespan }} · EXHIBIT {{ selected.exhibit }}</span>
  </div>

  <div class="goodbye-full-stage">
    <div class="goodbye-full-hero outline rounded">
      <img class="goodbye-image goodbye-image--hero" src="{{ selected.image_url }}" alt="{{ selected.image_alt }}">
    </div>

    <div class="goodbye-full-copy flex flex--col flex--between gap--small p--2">
      <div class="goodbye-full-identity flex flex--col gap--small">
        <span class="label goodbye-wordmark">GOODBYE,</span>
        <span class="title title--xlarge lg:title--xxlarge" data-clamp="2">{{ selected.name }}</span>
        <div class="divider"></div>
        <span class="description description--large lg:description--xlarge font--bold" data-clamp="3">{{ selected.epitaph }}</span>
      </div>

      <div class="goodbye-full-details flex flex--col gap--small">
        <div class="flex flex--col gap--xsmall">
          <span class="label text--gray-30">WHY IT DISAPPEARED</span>
          <span class="description description--large lg:description--xlarge" data-clamp="3">{{ selected.why }}</span>
        </div>

        <div class="goodbye-afterlife flex flex--row gap--small pt--small">
          <span class="label label--inverted">STILL HERE</span>
          <span class="description description--large lg:description--xlarge" data-clamp="3">{{ selected.afterlife }}</span>
        </div>
      </div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <div class="outline rounded p--4 flex flex--col flex--center gap--small w--full h--full text--center">
    <span class="label goodbye-wordmark">GOODBYE</span>
    <span class="title title--xxlarge">The museum is closed</span>
    <span class="description description--large">No farewell entries were received. Check the polling source.</span>
  </div>
</div>
{% endif %}

<div class="title_bar">
  <span class="title goodbye-titlebar">{{ goodbye_mark }} GOODBYE</span>
  <span class="instance">
    {% if selected %}
      {{ selected.status }} · {{ selected.category }} · LAST SEEN {{ selected.end_year }}
    {% elsif filter_fallback %}
      Filter unavailable
    {% else %}
      Data unavailable
    {% endif %}
  </span>
</div>
