{% if selected %}
<div class="layout layout--col layout--stretch">
  <div class="outline rounded p--3 flex flex--col flex--between gap--small w--full h--full">
    <div class="flex flex--row flex--between flex--center-y gap--small">
      <span class="label goodbye-wordmark">GOODBYE,</span>
      <span class="label label--outline">{{ selected.status | upcase }}</span>
    </div>
    <div class="flex flex--row flex--between flex--bottom gap--small">
      <span class="value value--xlarge lg:value--xxlarge goodbye-year">{{ selected.end_year }}</span>
      <span class="label text--right">{{ selected.lifespan }}<br>{{ selected.category }}</span>
    </div>
    <div class="divider"></div>
    <span class="title {{ compact_name_size }}" data-clamp="2">{{ selected.name }}</span>
    <span class="description {{ compact_epitaph_size }} font--bold" data-clamp="4">{{ selected.epitaph }}</span>
    {% if show_afterlife %}
      <div class="flex flex--col gap--xsmall pt--small">
        <span class="label text--gray-30">STILL HERE</span>
        <span class="description description--base" data-clamp="2">{{ selected.afterlife }}</span>
      </div>
    {% endif %}
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title title--xlarge">No farewell data</span>
</div>
{% endif %}

<div class="title_bar">
  <span class="title goodbye-titlebar">{{ goodbye_mark }} GOODBYE</span>
  <span class="instance">{% if selected %}{{ selected.category }}{% else %}Data unavailable{% endif %}</span>
</div>

