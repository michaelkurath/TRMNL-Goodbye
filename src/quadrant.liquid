{% if selected %}
<div class="layout layout--col layout--stretch">
  <div class="outline rounded p--3 flex flex--col flex--between gap--small w--full h--full">
    <div class="flex flex--row flex--between flex--center-y gap--small">
      <span class="label goodbye-wordmark">GOODBYE,</span>
      <span class="label label--outline">{{ selected.status | upcase }}</span>
    </div>
    <div class="goodbye-image-frame goodbye-image--quadrant rounded">
      <img class="goodbye-image" src="{{ selected.image_url }}" alt="{{ selected.image_alt }}">
    </div>
    <div class="flex flex--row flex--between flex--bottom gap--small">
      <span class="value value--large lg:value--xxlarge goodbye-year">{{ selected.end_year }}</span>
      <span class="label text--right">{{ selected.category }}</span>
    </div>
    <div class="divider"></div>
    <span class="title {{ compact_name_size }}" data-clamp="2">{{ selected.name }}</span>
    <span class="description description--base lg:description--large font--bold" data-clamp="4">{{ selected.epitaph }}</span>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title title--large">No farewell data</span>
</div>
{% endif %}

<div class="title_bar">
  <span class="title goodbye-titlebar">{{ goodbye_mark }} GOODBYE</span>
  <span class="instance">{% if selected %}{{ selected.end_year }}{% else %}Offline{% endif %}</span>
</div>
